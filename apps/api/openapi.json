  "info": {
    "title": "TOMCOM German Learning API",
    "description": "One API for the learner app, admin portal, content studio and verify page.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+915500000002",
            "description": "Indian mobile number; spaces and 0/91 prefixes accepted"
          },
          "locale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ],
            "description": "Language of the SMS"
          }
        },
        "required": [
          "phone",
          "locale"
        ]
      },
      "OtpRequestResultDto": {
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "number"
          },
          "resendAfterSeconds": {
            "type": "number"
          }
        },
        "required": [
          "expiresInSeconds",
          "resendAfterSeconds"
        ]
      },
      "DeviceDto": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "description": "Installation ID generated by the app",
            "minLength": 8,
            "maxLength": 64
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios",
              "web"
            ]
          },
          "appVersion": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": [
          "clientId",
          "platform",
          "appVersion"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+915500000002"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "phone",
          "code",
          "device"
        ]
      },
      "TokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresInSeconds",
          "tokenType"
        ]
      },
      "OnboardingStateDto": {
        "type": "object",
        "properties": {
          "profileComplete": {
            "type": "boolean",
            "description": "Name, district and trade captured (FR-103, step 2b)"
          }
        },
        "required": [
          "profileComplete"
        ]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "learner",
              "trainer",
              "tomcom_admin",
              "author",
              "reviewer",
              "super_admin"
            ]
          },
          "uiLocale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ]
          },
          "onboarding": {
            "$ref": "#/components/schemas/OnboardingStateDto"
          }
        },
        "required": [
          "id",
          "role",
          "uiLocale",
          "onboarding"
        ]
      },
      "OtpVerifyResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "authenticated",
              "registration_required"
            ]
          },
          "tokens": {
            "description": "When status is authenticated",
            "allOf": [
              {
                "$ref": "#/components/schemas/TokensDto"
              }
            ]
          },
          "user": {
            "description": "When status is authenticated",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserSummaryDto"
              }
            ]
          },
          "registrationToken": {
            "type": "string",
            "description": "When status is registration_required: pass to POST /auth/register"
          },
          "registrationExpiresInSeconds": {
            "type": "number"
          }
        },
        "required": [
          "status"
        ]
      },
      "ConsentInputDto": {
        "type": "object",
        "properties": {
          "noticeVersion": {
            "type": "number",
            "description": "Version of the notice the learner saw"
          },
          "purposes": {
            "example": [
              "learning",
              "progress_sharing"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "noticeVersion",
          "purposes"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "registrationToken": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ],
            "description": "Interface language chosen by the learner (FR-102)"
          },
          "consent": {
            "$ref": "#/components/schemas/ConsentInputDto"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "registrationToken",
          "locale",
          "consent",
          "device"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "tokens": {
            "$ref": "#/components/schemas/TokensDto"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummaryDto"
          }
        },
        "required": [
          "tokens",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ConsentPurposeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "required",
          "label"
        ]
      },
      "ConsentNoticeDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "locale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ]
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "purposes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentPurposeDto"
            }
          }
        },
        "required": [
          "version",
          "locale",
          "title",
          "text",
          "purposes"
        ]
      }
    }
  }
}
