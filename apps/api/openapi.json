  "info": {
    "title": "TOMCOM German Learning API",
    "description": "One API for the learner app, admin portal, content studio and verify page.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AuditEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "actorId": {
            "type": "string",
            "nullable": true
          },
          "actorRole": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "entityType": {
            "type": "string",
            "nullable": true
          },
          "entityId": {
            "type": "string",
            "nullable": true
          },
          "outcome": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "at",
          "action",
          "outcome"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+915500000002",
            "description": "Indian mobile number; spaces and 0/91 prefixes accepted"
          },
          "locale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ],
            "description": "Language of the SMS"
          }
        },
        "required": [
          "phone",
          "locale"
        ]
      },
      "OtpRequestResultDto": {
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "number"
          },
          "resendAfterSeconds": {
            "type": "number"
          }
        },
        "required": [
          "expiresInSeconds",
          "resendAfterSeconds"
        ]
      },
      "DeviceDto": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "description": "Installation ID generated by the app",
            "minLength": 8,
            "maxLength": 64
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios",
              "web"
            ]
          },
          "appVersion": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": [
          "clientId",
          "platform",
          "appVersion"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+915500000002"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "phone",
          "code",
          "device"
        ]
      },
      "TokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresInSeconds",
          "tokenType"
        ]
      },
      "OnboardingStateDto": {
        "type": "object",
        "properties": {
          "profileComplete": {
            "type": "boolean",
            "description": "Name, district and trade captured (FR-103, step 2b)"
          }
        },
        "required": [
          "profileComplete"
        ]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "learner",
              "trainer",
              "tomcom_admin",
              "author",
              "reviewer",
              "super_admin"
            ]
          },
          "uiLocale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ]
          },
          "onboarding": {
            "$ref": "#/components/schemas/OnboardingStateDto"
          }
        },
        "required": [
          "id",
          "role",
          "uiLocale",
          "onboarding"
        ]
      },
      "OtpVerifyResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "authenticated",
              "registration_required"
            ]
          },
          "tokens": {
            "description": "When status is authenticated",
            "allOf": [
              {
                "$ref": "#/components/schemas/TokensDto"
              }
            ]
          },
          "user": {
            "description": "When status is authenticated",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserSummaryDto"
              }
            ]
          },
          "registrationToken": {
            "type": "string",
            "description": "When status is registration_required: pass to POST /auth/register"
          },
          "registrationExpiresInSeconds": {
            "type": "number"
          }
        },
        "required": [
          "status"
        ]
      },
      "ConsentInputDto": {
        "type": "object",
        "properties": {
          "noticeVersion": {
            "type": "number",
            "description": "Version of the notice the learner saw"
          },
          "purposes": {
            "example": [
              "learning",
              "progress_sharing"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "noticeVersion",
          "purposes"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "registrationToken": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ],
            "description": "Interface language chosen by the learner (FR-102)"
          },
          "consent": {
            "$ref": "#/components/schemas/ConsentInputDto"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "registrationToken",
          "locale",
          "consent",
          "device"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "tokens": {
            "$ref": "#/components/schemas/TokensDto"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummaryDto"
          }
        },
        "required": [
          "tokens",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ConsentPurposeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "required",
          "label"
        ]
      },
      "ConsentNoticeDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "locale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ]
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "purposes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentPurposeDto"
            }
          }
        },
        "required": [
          "version",
          "locale",
          "title",
          "text",
          "purposes"
        ]
      },
      "StaffLoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+915599990001"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "StaffChallengeDto": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string",
            "description": "Pass to POST /staff-auth/verify with the OTP"
          },
          "expiresInSeconds": {
            "type": "number"
          },
          "resendAfterSeconds": {
            "type": "number"
          }
        },
        "required": [
          "challengeToken",
          "expiresInSeconds",
          "resendAfterSeconds"
        ]
      },
      "StaffVerifyDto": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "challengeToken",
          "code",
          "device"
        ]
      },
      "ReferenceItemDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "warangal"
          },
          "name": {
            "type": "object",
            "example": {
              "te": "వరంగల్",
              "en": "Warangal"
            },
            "description": "Name keyed by locale"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "districtCode": {
            "type": "string"
          },
          "tradeCode": {
            "type": "string"
          },
          "targetJob": {
            "type": "string",
            "nullable": true
          },
          "selfDeclaredLevel": {
            "type": "string",
            "enum": [
              "none",
              "A1",
              "A2",
              "B1"
            ]
          }
        },
        "required": [
          "districtCode",
          "tradeCode",
          "selfDeclaredLevel"
        ]
      },
      "BatchSummaryDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enrolledAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "enrolledAt"
        ]
      },
      "MeOnboardingDto": {
        "type": "object",
        "properties": {
          "profileComplete": {
            "type": "boolean"
          },
          "batchJoined": {
            "type": "boolean"
          }
        },
        "required": [
          "profileComplete",
          "batchJoined"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "uiLocale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ]
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "profile": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProfileDto"
              }
            ]
          },
          "batch": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/BatchSummaryDto"
              }
            ]
          },
          "onboarding": {
            "$ref": "#/components/schemas/MeOnboardingDto"
          }
        },
        "required": [
          "id",
          "role",
          "uiLocale",
          "onboarding"
        ]
      },
      "UpdateLocaleDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ]
          }
        },
        "required": [
          "locale"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Ravi",
            "maxLength": 50
          },
          "lastName": {
            "type": "string",
            "example": "Kumar",
            "maxLength": 50
          },
          "districtCode": {
            "type": "string",
            "example": "warangal",
            "description": "Code from GET /reference/districts"
          },
          "tradeCode": {
            "type": "string",
            "example": "electrician",
            "description": "Code from GET /reference/trades"
          },
          "targetJob": {
            "type": "string",
            "example": "Electrician in Munich",
            "maxLength": 80
          },
          "selfDeclaredLevel": {
            "type": "string",
            "enum": [
              "none",
              "A1",
              "A2",
              "B1"
            ],
            "description": "Self-declared current German level"
          }
        },
        "required": [
          "firstName",
          "districtCode",
          "tradeCode",
          "selfDeclaredLevel"
        ]
      },
      "JoinBatchDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "TST-001",
            "maxLength": 20
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
