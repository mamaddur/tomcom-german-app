// Database schema. Change only through `prisma migrate dev`; never edit an applied migration.
// Tables arrive with the step that needs them (see docs/build-plan.md).
// Connection settings live in prisma.config.ts (migrate) and PrismaService (runtime adapter).

generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  importFileExtension  = "js"
  previewFeatures      = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto]
}
