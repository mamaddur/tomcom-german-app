# Copy to .env.local for development, or let scripts/dev-services.sh create it with random keys.
# Never commit real keys. Synthetic data only.
APP_ENV=dev
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://tomcom:tomcom@localhost:5432/tomcom_dev
REDIS_URL=redis://localhost:6379/0
# Generate each with: openssl rand -base64 32
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
JWT_SECRET=
# Synthetic +9155… numbers log in with this OTP; no SMS is sent.
DEV_OTP=123456
SMS_PROVIDER=none
# AI tutor: `dev` is a built-in stand-in for local demos; `none` switches the tutor off.
LLM_PROVIDER=dev
# Object storage for media and lesson packs. Dev: RustFS from docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=tomcom-dev
S3_ACCESS_KEY=tomcom-dev
S3_SECRET_KEY=tomcom-dev-secret
# Password for the synthetic staff accounts created by seed:dev (dev-services.sh generates one).
DEV_STAFF_PASSWORD=
# Public certificate verification page (web app route /c/{code}); QR codes on certificates point here.
VERIFY_BASE_URL=http://localhost:3001/c
