# Copy to .env.local for development, or let scripts/dev-services.sh create it with random keys.
# Never commit real keys. Synthetic data only.
APP_ENV=dev
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://tomcom:tomcom@localhost:5432/tomcom_dev
REDIS_URL=redis://localhost:6379/0
# Generate each with: openssl rand -base64 32
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
JWT_SECRET=
# Synthetic +9155… numbers log in with this OTP; no SMS is sent.
DEV_OTP=123456
SMS_PROVIDER=none
# Password for the synthetic staff accounts created by seed:dev (dev-services.sh generates one).
DEV_STAFF_PASSWORD=
